# BlueprintIQ Environment Configuration

# -------------------------------------------------------------
# Local AI Engine (Ollama - strictly Gemma 2B)
# -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
OLLAMA_TIMEOUT=60.0

# -------------------------------------------------------------
# Supabase PostgreSQL + pgvector + Storage Configuration
# (If left empty, BlueprintIQ automatically uses its local resilient store)
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
